# ============================================================
# Sharik Production Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# ▶ REQUIRED — Server will not start without these
# -------------------------------------------------

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/all-data?appName=Cluster0

# JWT signing secret — use a long random string (min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

# Node environment (set to "production" on Railway/cloud)
NODE_ENV=production


# ▶ OPTIONAL — Have defaults, but recommended to set
# ---------------------------------------------------

# Server port (Railway sets this automatically)
PORT=3000

# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=https://sharij-532a3.web.app,https://sharij-532a3.firebaseapp.com

# Frontend app URL (used in email links)
APP_URL=https://sharij-532a3.web.app

# Redis URL for Socket.IO multi-instance scaling (optional)
# REDIS_URL=redis://default:PASSWORD@redis-host:6379

# Email service (optional — for password reset emails)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=Sharik <your@gmail.com>

# AI features (optional — for roadmap/mentor/quiz endpoints)
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key

# Rate limiting (optional — defaults shown)
# RATE_LIMIT_AUTH_MAX=30
# RATE_LIMIT_API_MAX=120
